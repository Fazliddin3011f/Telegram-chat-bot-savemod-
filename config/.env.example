# @BotFather dan olingan Telegram bot token
BOT_TOKEN=123456:ABC-DEF...

# https://www.fragmently.uz dashboard'idan olingan API token
FRAGMENTLY_TOKEN=your_fragmently_api_token_here

# Ixtiyoriy: faqat shu Telegram user ID lariga ruxsat (vergul bilan).
# Bo'sh qoldirilsa - hammaga ochiq (agar ADMIN_USERNAMES ham bo'sh bo'lsa).
ALLOWED_USER_IDS=

# Ixtiyoriy: admin username lar (vergul bilan, @ ixtiyoriy).
# Masalan: WaSaVi yoki @WaSaVi,@boshqa_admin
ADMIN_USERNAMES=

# ============================================
# SaveMod Userbot sozlamalari
# ============================================

# Telethon API credentials (https://my.telegram.org)
API_ID=123456
API_HASH=your_api_hash_here

# Telefon raqam (ixtiyoriy, bo'sh qoldirilsa terminalda so'raydi)
# Masalan: +998901234567
PHONE=

# Monitoring sozlamalari
MONITOR_GROUPS=false      # Guruhlarni kuzatish (true/false)
MONITOR_CHANNELS=false    # Kanallarni kuzatish (true/false) - ADMIN bo'lish kerak!
CACHE_HOURS=48            # Xabarlarni necha soat saqlash

# Bildirishnoma uchun
TARGET=me                 # Qayerga xabar yuborish (me = o'zingizga)
OWNER_CHAT_ID=            # Admin chat ID (raqam)

# ============================================
# Google Sheets integratsiyasi (Apps Script bilan)
# ============================================

# Variant 1: Apps Script (Tavsiya etilgan - bepul va oson)
# Apps Script Web App URL
# Qanday olish: docs/APPS_SCRIPT_SETUP.md
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Xavfsizlik tokeni (ixtiyoriy)
APPS_SCRIPT_TOKEN=your_secret_token_here

# Variant 2: Python gspread (Murakkab, credentials kerak)
# Google Sheets ID
GOOGLE_SHEETS_ID=your_sheet_id_here
