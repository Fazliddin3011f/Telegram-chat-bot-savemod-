# https://my.telegram.org -> "API development tools" dan oling
API_ID=123456
API_HASH=abcdef1234567890abcdef1234567890

# Sizning Telegram raqamingiz (xalqaro format), masalan +998901234567
PHONE=+998XXXXXXXXX

# --- 1-variant: Telegram bot orqali (tavsiya etiladi) ---
# Bot token (@BotFather dan) - bildirishnomalar shu bot orqali yuboriladi
BOT_TOKEN=
# Sizning shaxsiy Telegram ID ingiz (bot xabarlarni shu chatga yuboradi)
# Bilish uchun @userinfobot ga /start yuboring
OWNER_CHAT_ID=

# --- 2-variant: agar BOT_TOKEN bo'lmasa, userbot o'zi yuboradi ---
# "me" => Saved Messages, @username yoki -100xxxxxxxxx
TARGET=me

# Guruh va kanallarni ham kuzatishmi? (true / false)
MONITOR_GROUPS=false

# Kesh qancha vaqt saqlansin (soatda)
CACHE_HOURS=48
